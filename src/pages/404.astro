---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="Page not found" description="This page does not exist. Go to the home page or the project index." path="404.html" noindex>
  <section class="case-header on-ink" aria-labelledby="nf-title">
    <div class="wrap">
      <h1 id="nf-title">Page not found</h1>
      <p class="hero-support muted">The page you were looking for does not exist or has moved.</p>
      <ul class="actions">
        <li><a class="btn btn-primary" href={withBase()}>Go to the home page</a></li>
        <li><a class="btn btn-secondary" href={withBase('projects/')}>See all projects</a></li>
      </ul>
    </div>
  </section>
</Base>
